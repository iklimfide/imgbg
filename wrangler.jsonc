{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imgbg",
	"main": ".open-next/worker.js",
	"build": {
		"command": "npx opennextjs-cloudflare build"
	},
	"compatibility_date": "2026-11-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "imgbg"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imgbg",
			"database_id": "ef41b473-7d48-4131-b4eb-715674463475",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "hizliresim"
		}
	],
	"vars": {
		"USE_SHARP": "0",
		"R2_BUCKET": "hizliresim",
		"NEXT_PUBLIC_SITE_URL": "https://imgbg.net",
		"BETTER_AUTH_URL": "https://imgbg.net"
	}
}